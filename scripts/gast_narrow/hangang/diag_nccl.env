# NCCL / torch flight-recorder diagnostics for a hung collective (sourced by diag_v23.sbatch when DIAG_NCCL=1)
export NARROW_PG_TIMEOUT_MIN=5 TORCH_NCCL_TRACE_BUFFER_SIZE=2000 TORCH_NCCL_DUMP_ON_TIMEOUT=1 TORCH_NCCL_DESYNC_DEBUG=1
export TORCH_NCCL_DEBUG_INFO_TEMP_FILE=$G/logs/nccltrace_${SLURM_JOB_ID}/rank_
export NARROW_TORCHRUN_ARGS="--log_dir $G/logs/ranklogs_${SLURM_JOB_ID} --redirects 3"
mkdir -p $G/logs/nccltrace_${SLURM_JOB_ID}
